        </main>
        <footer>
            <p>&copy; <%= new Date().getFullYear() %> Pangasinan State University  OJT Management & Monitoring Portal</p>
        </footer>
    </div>

    <% if (typeof user !== 'undefined' && user) { %>
    <div id="chatbot-widget" class="chatbot-widget">
        <div id="chatbot-toggle" class="chatbot-toggle">
            <i class="bi bi-chat-dots-fill"></i>
        </div>
        <div id="chatbot-container" class="chatbot-container d-none">
            <div class="chatbot-header">
                <h6 class="mb-0">OJT Portal Assistant</h6>
                <button id="chatbot-close" class="btn btn-sm btn-link text-white">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="chatbot-faq" class="chatbot-faq">
                <div class="chatbot-faq-title">Frequently Asked Questions</div>
                <div class="chatbot-faq-list">
                    <button class="chatbot-faq-item" data-question="How do I upload my MOA?">How do I upload my MOA?</button>
                    <button class="chatbot-faq-item" data-question="What is the MOA status?">What is the MOA status?</button>
                    <button class="chatbot-faq-item" data-question="How do I register?">How do I register?</button>
                    <button class="chatbot-faq-item" data-question="How do I update my profile?">How do I update my profile?</button>
                    <button class="chatbot-faq-item" data-question="Where can I see announcements?">Where can I see announcements?</button>
                    <button class="chatbot-faq-item" data-question="How do I contact the coordinator?">How do I contact the coordinator?</button>
                </div>
            </div>
            <div id="chatbot-messages" class="chatbot-messages"></div>
            <div class="chatbot-input">
                <input type="text" id="chatbot-input" class="form-control" placeholder="Ask a question...">
                <button id="chatbot-send" class="btn btn-primary btn-sm">
                    <i class="bi bi-send"></i>
                </button>
            </div>
        </div>
    </div>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
    <% if (typeof user !== 'undefined' && user) { %>
    <script src="/js/chatbot.js"></script>
    <% } %>
</body>
</html>
