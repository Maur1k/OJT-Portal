<%- include('../partials/header') %>

<div class="container mt-4">
    <h2 class="mb-4">MOA for Signature</h2>

    <% if (typeof query !== 'undefined' && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= query.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
        <%= query.error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- Search and Filter -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="GET" action="/director/moa" class="row g-3">
                <div class="col-md-8">
                    <input type="text" class="form-control" name="search" placeholder="Search by name or student number..." value="<%= typeof search !== 'undefined' ? search : '' %>">
                </div>
                <div class="col-md-2">
                    <select class="form-control" name="course">
                        <option value="all" <%= course === 'all' ? 'selected' : '' %>>All Courses</option>
                        <% courses.forEach(c => { %>
                            <option value="<%= c %>" <%= course === c ? 'selected' : '' %>><%= c %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MOA List -->
    <div class="card">
        <div class="card-body">
            <% if (typeof moas !== 'undefined' && moas.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Student Number</th>
                            <th>Course</th>
                            <th>Company</th>
                            <th>Uploaded</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% moas.forEach(moa => { %>
                        <tr>
                            <td>
                                <%= moa.profile ? moa.profile.firstName + ' ' + (moa.profile.middleName || '') + ' ' + moa.profile.lastName : moa.studentId.email %>
                            </td>
                            <td><%= moa.profile ? moa.profile.studentNumber : 'N/A' %></td>
                            <td><%= moa.profile ? moa.profile.course || '—' : '—' %></td>
                            <td><%= moa.profile ? moa.profile.companyName : 'N/A' %></td>
                            <td><%= new Date(moa.uploadedAt).toLocaleDateString() %></td>
                            <td>
                                <a href="/<%= moa.filePath %>" target="_blank" class="btn btn-sm btn-info me-2">
                                    <i class="bi bi-download"></i> View MOA
                                </a>
                                <form method="POST" action="/director/moa/<%= moa._id %>/sign" class="d-inline" onsubmit="return confirm('Are you sure you want to sign this MOA? This action cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check-circle"></i> Sign MOA
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <nav>
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= course && course !== 'all' ? '&course=' + course : '' %>">Previous</a>
                    </li>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= course && course !== 'all' ? '&course=' + course : '' %>"><%= i %></a>
                    </li>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= course && course !== 'all' ? '&course=' + course : '' %>">Next</a>
                    </li>
                    <% } %>
                </ul>
            </nav>
            <% } %>
            <% } else { %>
            <p class="text-center text-muted py-5">No MOA files pending signature.</p>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

