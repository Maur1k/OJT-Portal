                                        data-requirement-label="<%= item.label %>">
                                        <i class="bi bi-upload"></i> Upload
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadRequirementModal" tabindex="-1" aria-labelledby="uploadRequirementModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadRequirementModalLabel">Upload Requirement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="/student/requirements/upload" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="requirementKey" id="requirementKeyInput">
                    <input type="hidden" name="fileType" id="fileTypeInput">
                    <div class="mb-3">
                        <label class="form-label">Requirement</label>
                        <input type="text" class="form-control" id="requirementLabelInput" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">File (PDF or Image) <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required>
                        <small class="text-muted">Maximum file size: 10MB</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const uploadModal = document.getElementById('uploadRequirementModal');
    if (uploadModal) {
        uploadModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            const requirementKey = button.getAttribute('data-requirement-key');
            const requirementLabel = button.getAttribute('data-requirement-label');

            uploadModal.querySelector('#requirementKeyInput').value = requirementKey;
            uploadModal.querySelector('#fileTypeInput').value = requirementKey; // helps route storage
            uploadModal.querySelector('#requirementLabelInput').value = requirementLabel;
        });
    }
</script>

<%- include('../partials/footer') %>


