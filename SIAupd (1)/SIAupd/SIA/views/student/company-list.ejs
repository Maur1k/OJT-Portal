<%- include('../partials/header') %>

<div class="container mt-4">
  <% if (query && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= query.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (query && query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= query.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="mb-0">Available Companies</h2>
      <% if (typeof studentCourse !== 'undefined' && studentCourse) { %>
      <p class="text-muted mb-0">
        Showing companies available for <strong><%= studentCourse %></strong>
        <span class="badge bg-info ms-2"><%= companies.length %> company/companies</span>
      </p>
      <% } else { %>
      <p class="text-muted mb-0">Browse available companies/agencies and view details.</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <% if (!hasCompanies) { %>
        <div class="alert alert-info mb-0">
          No companies found. Showing an example entry. Add real companies to replace this.
        </div>
      <% } else if (companies.length === 0) { %>
        <div class="alert alert-warning mb-0">
          <strong>No companies available for your course (<%= studentCourse %>).</strong>
          <br>Companies are filtered based on course restrictions. Contact your coordinator if you need access to additional companies.
        </div>
      <% } %>

      <div class="table-responsive mt-3">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Location</th>
              <th>Available For</th>
              <th>Application Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% companies.forEach(c => { %>
              <tr>
                <td>
                  <%= c.name %>
                  <% if (c.source === 'partner') { %>
                  <span class="badge bg-secondary ms-1">Partner</span>
                  <% } %>
                </td>
                <td><%= c.address || '—' %></td>
                <td>
                  <% if (c.availableForCourses && c.availableForCourses.length > 0) { %>
                    <% c.availableForCourses.forEach((course, idx) => { %>
                      <span class="badge bg-primary me-1"><%= course %></span>
                    <% }); %>
                  <% } else { %>
                    <span class="badge bg-success">All Courses</span>
                  <% } %>
                </td>
                <td>
                  <% if (c.application) { %>
                    <% 
                      const statusLabels = {
                        'pending': 'Pending',
                        'accepted': 'Accepted',
                        'rejected': 'Rejected',
                        'cancelled': 'Cancelled'
                      };
                      const statusColors = {
                        'pending': 'warning',
                        'accepted': 'success',
                        'rejected': 'danger',
                        'cancelled': 'secondary'
                      };
                      const statusLabel = statusLabels[c.application.status] || c.application.status;
                      const statusColor = statusColors[c.application.status] || 'secondary';
                    %>
                    <span class="badge bg-<%= statusColor %>">
                      <%= statusLabel %>
                    </span>
                  <% } else { %>
                    <span class="text-muted">Not Applied</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/student/companies/<%= c._id %>" class="btn btn-primary btn-sm">
                    <i class="bi bi-box-arrow-up-right"></i> View
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>


