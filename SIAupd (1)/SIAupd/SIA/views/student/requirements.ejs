                                <% } else { %>
                                    &mdash;
                                <% } %>
                            </td>
                            <td><%= item.file ? new Date(item.file.uploadedAt).toLocaleString() : '—' %></td>
                            <td class="text-end">
                                <% if (item.file) { %>
                                    <a href="/<%= item.file.filePath %>" target="_blank" class="btn btn-outline-secondary btn-sm me-2" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button 
                                        class="btn btn-outline-primary btn-sm me-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#uploadRequirementModal"
                                        data-requirement-key="<%= item.key %>"
                                        data-requirement-label="<%= item.label %>"
                                        title="Replace">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                    <form method="POST" action="/student/requirements/delete/<%= item.file._id %>" class="d-inline" onsubmit="return confirm('Remove this requirement file?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove">
                                            <i class="bi bi-trash"></i>
