<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="dashboard-header">
        <h2>Director Dashboard</h2>
        <p>Overview of verified students, MOA signatures, and system statistics</p>
    </div>

    <% if (typeof query !== 'undefined' && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= query.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <div class="stat-cards-grid">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Verified Students</h5>
                <h3 class="mb-0"><%= verifiedStudents %></h3>
            </div>
        </div>
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Total MOAs</h5>
                <h3 class="mb-0"><%= typeof totalMOAs !== 'undefined' ? totalMOAs : 0 %></h3>
            </div>
        </div>
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Pending Signatures</h5>
                <h3 class="mb-0"><%= pendingSignatures %></h3>
            </div>
        </div>
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Completed MOAs</h5>
                <h3 class="mb-0"><%= completedMOAs %></h3>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">Recent Signatures</h5>
                <a href="/director/moa" class="btn btn-sm btn-primary">
                    <i class="bi bi-file-earmark-text"></i> View All MOAs
                </a>
            </div>
        </div>
        <div class="card-body">
            <% if (typeof recentSignatures !== 'undefined' && recentSignatures.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Signed Date</th>
                            <th>Director</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentSignatures.forEach(moa => { %>
                        <tr>
                            <td>
                                <i class="bi bi-person-circle me-2"></i>
                                <%= moa.studentId.email %>
                            </td>
                            <td>
                                <i class="bi bi-calendar-check me-2"></i>
                                <%= new Date(moa.signedAt).toLocaleDateString() %>
                            </td>
                            <td>
                                <i class="bi bi-person-badge me-2"></i>
                                <%= moa.directorId ? moa.directorId.email : 'N/A' %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="text-center py-4">
                <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d; opacity: 0.5;"></i>
                <p class="text-muted mt-3 mb-0">No recent signatures.</p>
            </div>
            <% } %>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="quick-actions">
                <a href="/director/students" class="btn btn-outline-primary">
                    <i class="bi bi-people"></i> View Verified Students
                </a>
                <a href="/director/moa" class="btn btn-outline-primary">
                    <i class="bi bi-file-earmark-check"></i> MOA for Signature
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

