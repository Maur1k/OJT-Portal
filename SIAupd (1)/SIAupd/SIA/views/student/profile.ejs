<%- include('../partials/header') %>

<div class="container mt-4">
    <h2 class="mb-4">My Profile</h2>

    <% if (typeof query !== 'undefined' && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= query.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
        <%= query.error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (typeof profile !== 'undefined' && profile) { %>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Student Information</h5>
            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">Edit Profile</button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Student Number:</strong> <%= profile.studentNumber %></p>
                    <p><strong>Name:</strong> <%= profile.firstName %> <%= profile.middleName || '' %> <%= profile.lastName %></p>
                    <p><strong>Course:</strong> <%= profile.course %></p>
                    <p><strong>Year Level:</strong> <%= profile.yearLevel %></p>
                    <p><strong>Section:</strong> <%= profile.section || 'N/A' %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Contact Number:</strong> <%= profile.contactNumber %></p>
                    <p><strong>Address:</strong> <%= profile.address %></p>
                    <% if (profile.emergencyContact && profile.emergencyContact.name) { %>
                    <p><strong>Emergency Contact:</strong> <%= profile.emergencyContact.name %> (<%= profile.emergencyContact.relationship %>) - <%= profile.emergencyContact.contactNumber %></p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Information (if exists) -->
    <% if (profile.companyName) { %>
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Company Information</h5>
            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editCompanyInfoModal">Edit Company Info</button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Company Name:</strong> <%= profile.companyName %></p>
                    <p><strong>Company Address:</strong> <%= profile.companyAddress || 'N/A' %></p>
                    <p><strong>Company Contact:</strong> <%= profile.companyContact || 'N/A' %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Supervisor Name:</strong> <%= profile.supervisorName || 'N/A' %></p>
                    <p><strong>Supervisor Position:</strong> <%= profile.supervisorPosition || 'N/A' %></p>
                    <p><strong>Supervisor Email:</strong> <%= profile.supervisorEmail || 'N/A' %></p>
                    <p><strong>Supervisor Contact:</strong> <%= profile.supervisorContact || 'N/A' %></p>
                </div>
            </div>
            <% if (profile.ojtStartDate && profile.ojtEndDate) { %>
            <hr>
            <p><strong>OJT Period:</strong> <%= new Date(profile.ojtStartDate).toLocaleDateString() %> to <%= new Date(profile.ojtEndDate).toLocaleDateString() %></p>
            <% } %>
        </div>
    </div>
    <% } %>

    <!-- Resume Section -->
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Resume</h5>
            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#uploadResumeModal">Upload Resume</button>
        </div>
        <div class="card-body">
            <% if (profile.resumePath) { %>
            <p><strong>Resume:</strong> <a href="/<%= profile.resumePath %>" target="_blank" class="btn btn-sm btn-outline-primary">View Resume</a></p>
            <% } else { %>
            <p class="text-muted">No resume uploaded yet.</p>
            <% } %>
        </div>
    </div>

    <!-- Narrative Section -->
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Narrative</h5>
            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editNarrativeModal">Edit Narrative</button>
        </div>
        <div class="card-body">
            <% if (profile.narrative) { %>
            <p style="white-space: pre-wrap;"><%= profile.narrative %></p>
            <% } else { %>
            <p class="text-muted">No narrative added yet.</p>
            <% } %>
        </div>
    </div>

    <!-- Proof Photos Section -->
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Proof Photos (OJT Evidence)</h5>
            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#uploadProofPhotosModal">Upload Photos</button>
        </div>
        <div class="card-body">
            <% if (profile.proofPhotos && profile.proofPhotos.length > 0) { %>
            <div class="row">
                <% profile.proofPhotos.forEach((photo, index) => { %>
                <div class="col-md-3 mb-3">
                    <div class="position-relative">
                        <img src="/<%= photo %>" alt="Proof Photo <%= index + 1 %>" class="img-thumbnail" style="width: 100%; height: 200px; object-fit: cover;">
                        <form method="POST" action="/student/profile/proof-photos/<%= index %>/delete" class="position-absolute top-0 end-0 m-1" onsubmit="return confirm('Are you sure you want to delete this photo?');">
                            <button type="submit" class="btn btn-sm btn-danger">×</button>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <p class="text-muted">No proof photos uploaded yet.</p>
            <% } %>
        </div>
    </div>

    <!-- Approved Companies/Agencies -->
    <% if (typeof approvedCompanies !== 'undefined' && approvedCompanies.length > 0) { %>
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">Approved Companies/Agencies</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <% approvedCompanies.forEach(company => { %>
                <div class="col-md-6 mb-3">
                    <div class="card border-success">
                        <div class="card-body">
                            <h6 class="card-title">
                                <%= company.name %>
                                <span class="badge bg-success ms-2"><%= company.type === 'company' ? 'Company' : 'Agency' %></span>
                            </h6>
                            <p class="card-text mb-1"><strong>Address:</strong> <%= company.address %></p>
                            <p class="card-text mb-1"><strong>Contact:</strong> <%= company.contact %></p>
                            <% if (company.email) { %>
                            <p class="card-text mb-1"><strong>Email:</strong> <%= company.email %></p>
                            <% } %>
                            <% if (company.website) { %>
                            <p class="card-text mb-1"><strong>Website:</strong> <a href="<%= company.website %>" target="_blank"><%= company.website %></a></p>
                            <% } %>
                            <small class="text-muted">Approved on: <%= new Date(company.approvedAt).toLocaleDateString() %></small>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Accepted MOA Requests -->
    <% if (typeof acceptedRequests !== 'undefined' && acceptedRequests.length > 0) { %>
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">Accepted MOA Requests</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Company/Agency</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Reviewed</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% acceptedRequests.forEach(request => { %>
                        <tr>
                            <td><%= request.companyName %></td>
                            <td><span class="badge bg-info"><%= request.companyType === 'company' ? 'Company' : 'Agency' %></span></td>
                            <td><span class="badge bg-success">Accepted</span></td>
                            <td><%= request.reviewedAt ? new Date(request.reviewedAt).toLocaleDateString() : 'N/A' %></td>
                            <td>
                                <a href="/<%= request.filePath %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-file-pdf"></i> View PDF
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <% } %>
    <% } else { %>
    <div class="alert alert-warning">Profile not found. Please contact support.</div>
    <% } %>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/student/profile">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Contact Number</label>
                            <input type="text" class="form-control" name="contactNumber" value="<%= profile ? profile.contactNumber : '' %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" name="address" value="<%= profile ? profile.address : '' %>" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Emergency Contact Name</label>
                            <input type="text" class="form-control" name="emergencyContactName" value="<%= profile && profile.emergencyContact ? profile.emergencyContact.name : '' %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Relationship</label>
                            <input type="text" class="form-control" name="emergencyContactRelationship" value="<%= profile && profile.emergencyContact ? profile.emergencyContact.relationship : '' %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contact Number</label>
                            <input type="text" class="form-control" name="emergencyContactNumber" value="<%= profile && profile.emergencyContact ? profile.emergencyContact.contactNumber : '' %>">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload Resume Modal -->
<div class="modal fade" id="uploadResumeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Resume</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/student/profile/resume" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="resume" class="form-label">Resume File</label>
                        <input type="file" class="form-control" id="resume" name="resume" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required>
                        <small class="form-text text-muted">Accepted formats: PDF, DOC, DOCX, JPG, JPEG, PNG (Max 10MB)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload Resume</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Narrative Modal -->
<div class="modal fade" id="editNarrativeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Narrative</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/student/profile">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="narrative" class="form-label">Narrative</label>
                        <textarea class="form-control" id="narrative" name="narrative" rows="10" placeholder="Write your OJT narrative here..."><%= profile && profile.narrative ? profile.narrative : '' %></textarea>
                        <small class="form-text text-muted">Describe your OJT experience, learnings, and achievements.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Narrative</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload Proof Photos Modal -->
<div class="modal fade" id="uploadProofPhotosModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Proof Photos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/student/profile/proof-photos" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="proofPhotos" class="form-label">Proof Photos</label>
                        <input type="file" class="form-control" id="proofPhotos" name="proofPhotos" accept=".jpg,.jpeg,.png" multiple required>
                        <small class="form-text text-muted">You can upload up to 10 photos at once. Accepted formats: JPG, JPEG, PNG (Max 5MB per photo)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload Photos</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Company Information Modal (Students can edit company info but NOT OJT dates) -->
<div class="modal fade" id="editCompanyInfoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Company Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/student/profile/company-info">
                <div class="modal-body">
                    <h6 class="mb-3">Company Details</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="companyName" class="form-label">Company Name</label>
                            <input type="text" class="form-control" id="companyName" name="companyName" 
                                value="<%= profile.companyName || '' %>" placeholder="Enter company name">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="companyContact" class="form-label">Company Contact</label>
                            <input type="text" class="form-control" id="companyContact" name="companyContact" 
                                value="<%= profile.companyContact || '' %>" placeholder="Enter contact number">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="companyAddress" class="form-label">Company Address</label>
                        <textarea class="form-control" id="companyAddress" name="companyAddress" rows="2" 
                            placeholder="Enter company address"><%= profile.companyAddress || '' %></textarea>
                    </div>

                    <hr class="my-4">
                    <h6 class="mb-3">Supervisor Details</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="supervisorName" class="form-label">Supervisor Name</label>
                            <input type="text" class="form-control" id="supervisorName" name="supervisorName" 
                                value="<%= profile.supervisorName || '' %>" placeholder="Enter supervisor name">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="supervisorPosition" class="form-label">Supervisor Position</label>
                            <input type="text" class="form-control" id="supervisorPosition" name="supervisorPosition" 
                                value="<%= profile.supervisorPosition || '' %>" placeholder="Enter position">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="supervisorEmail" class="form-label">Supervisor Email</label>
                            <input type="email" class="form-control" id="supervisorEmail" name="supervisorEmail" 
                                value="<%= profile.supervisorEmail || '' %>" placeholder="Enter email address">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="supervisorContact" class="form-label">Supervisor Contact</label>
                            <input type="text" class="form-control" id="supervisorContact" name="supervisorContact" 
                                value="<%= profile.supervisorContact || '' %>" placeholder="Enter contact number">
                        </div>
                    </div>
                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle"></i> <strong>Note:</strong> OJT start and end dates can only be set by coordinators. Please contact your coordinator if you need to update the OJT period.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

