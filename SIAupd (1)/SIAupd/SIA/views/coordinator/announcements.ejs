<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Announcements</h2>
        <a href="/coordinator/announcements/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create Announcement
        </a>
    </div>

    <% if (typeof query !== 'undefined' && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= decodeURIComponent(query.success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
        <%= decodeURIComponent(query.error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
    <% announcements.forEach(announcement => { %>
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0"><%= announcement.title %></h5>
                <small class="text-muted">
                    <i class="bi bi-calendar"></i> <%= new Date(announcement.createdAt).toLocaleDateString() %>
                    <% if (announcement.postedBy) { %>
                    | <i class="bi bi-person"></i> <%= announcement.postedBy.email %>
                    <% } %>
                </small>
            </div>
            <div>
                <span class="badge bg-primary me-2"><%= announcement.type %></span>
                <% if (announcement.isArchived) { %>
                <span class="badge bg-warning">Archived</span>
                <% } else if (announcement.isActive) { %>
                <span class="badge bg-success">Active</span>
                <% } else { %>
                <span class="badge bg-secondary">Inactive</span>
                <% } %>
            </div>
        </div>
        <div class="card-body">
            <% if (announcement.imagePath) { %>
            <div class="mb-3">
                <img src="/<%= announcement.imagePath %>" alt="Announcement image" class="img-fluid rounded" style="max-height: 400px; width: auto;">
            </div>
            <% } %>
            <p class="card-text"><%= announcement.content.replace(/\n/g, '<br>') %></p>
            <div class="mt-3">
                <a href="/coordinator/announcements/<%= announcement._id %>/edit" class="btn btn-sm btn-primary">Edit</a>
                <% if (announcement.isActive && !announcement.isArchived) { %>
                <form method="POST" action="/coordinator/announcements/<%= announcement._id %>/archive" class="d-inline" onsubmit="return confirm('Are you sure you want to archive this announcement?');">
                    <button type="submit" class="btn btn-sm btn-danger">Archive</button>
                </form>
                <% } else if (announcement.isArchived) { %>
                <form method="POST" action="/coordinator/announcements/<%= announcement._id %>/unarchive" class="d-inline" onsubmit="return confirm('Are you sure you want to unarchive this announcement?');">
                    <button type="submit" class="btn btn-sm btn-success">Unarchive</button>
                </form>
                <% } %>
            </div>
        </div>
    </div>
    <% }); %>

    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <nav>
        <ul class="pagination justify-content-center">
            <% if (currentPage > 1) { %>
            <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
            </li>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>"><%= i %></a>
            </li>
            <% } %>
            <% if (currentPage < totalPages) { %>
            <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
            </li>
            <% } %>
        </ul>
    </nav>
    <% } %>
    <% } else { %>
    <div class="alert alert-info">No announcements yet. Create one to get started.</div>
    <% } %>
</div>

<%- include('../partials/footer') %>

