<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Requirements Checklist</h2>
            <p class="text-muted mb-0">Track, upload, and view your OJT pre and post requirements.</p>
        </div>
        <div class="text-end">
            <div class="fw-semibold">Completed <%= completedRequirements %> / <%= totalRequirements %></div>
            <small class="text-muted">Progress auto-updates after each upload.</small>
        </div>
    </div>

    <% if (query && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= query.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (query && query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
        <%= query.error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h5 class="card-title mb-1">Overall Progress</h5>
                    <small class="text-muted">Upload the required documents to unlock your OJT steps.</small>
                </div>
                <div class="fw-semibold fs-5"><%= progress %>%</div>
            </div>
            <div class="progress" style="height: 18px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: <%= progress %>%;" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Pre-deployment Requirements</h5>
                <small class="text-muted">Complete these before starting your OJT.</small>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Requirement</th>
                            <th>Status</th>
                            <th>Template</th>
                            <th>Last Upload</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% preRequirements.forEach(item => { %>
                        <tr>
                            <td><%= item.label %></td>
                            <td>
                                <% if (item.file) { %>
                                    <span class="badge bg-success text-white">Uploaded</span>
                                <% } else { %>
                                    <span class="badge bg-light text-dark border">Pending</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (item.templateUrl) { %>
                                    <a href="<%= item.templateUrl %>" class="btn btn-link btn-sm text-decoration-none" download title="Download template">
                                        <i class="bi bi-download"></i>
                                    </a>
                                <% } else { %>
                                    &mdash;
                                <% } %>
                            </td>
                            <td><%= item.file ? new Date(item.file.uploadedAt).toLocaleString() : '—' %></td>
                            <td class="text-end">
                                <% if (item.file) { %>
                                    <a href="/<%= item.file.filePath %>" target="_blank" class="btn btn-outline-secondary btn-sm me-2" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button 
                                        class="btn btn-outline-primary btn-sm me-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#uploadRequirementModal"
                                        data-requirement-key="<%= item.key %>"
                                        data-requirement-label="<%= item.label %>"
                                        title="Replace">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                    <form method="POST" action="/student/requirements/delete/<%= item.file._id %>" class="d-inline" onsubmit="return confirm('Remove this requirement file?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <button 
                                        class="btn btn-primary btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#uploadRequirementModal"
                                        data-requirement-key="<%= item.key %>"
                                        data-requirement-label="<%= item.label %>">
                                        <i class="bi bi-upload"></i> Upload
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-5">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Legal Forms</h5>
                <small class="text-muted">Required agreements and waivers.</small>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
