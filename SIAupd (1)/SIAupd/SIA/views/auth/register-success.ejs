<%- include('../partials/header') %>

<section class="psu-section">
    <div class="form-shell">
        <div class="form-card text-center">
            <i class="bi bi-patch-check-fill text-success" style="font-size: 3rem;"></i>
            <h2 class="mt-3">Registration complete!</h2>
            <p class="form-subtext"><%= typeof message !== 'undefined' ? message : 'Your student portal account has been created. Please wait for coordinator verification before logging in.' %></p>
            <a href="/auth/login" class="btn btn-primary">Proceed to login</a>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>

