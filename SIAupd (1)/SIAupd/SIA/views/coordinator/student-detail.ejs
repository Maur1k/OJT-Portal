<%- include('../partials/header') %>

<div class="container mt-4">
    <h2 class="mb-4">Student Details</h2>

    <% if (typeof query !== 'undefined' && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= query.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (typeof student !== 'undefined' && student) { %>
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Account Information</h5>
            <% if (!student.isVerified) { %>
            <form method="POST" action="/coordinator/students/<%= student._id %>/verify" class="d-inline">
                <button type="submit" class="btn btn-success btn-sm">Verify Account</button>
            </form>
            <% } else { %>
            <span class="badge bg-success">Verified</span>
            <% } %>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> <%= student.email %></p>
            <p><strong>Status:</strong> 
                <% if (student.isVerified) { %>
                <span class="badge bg-success">Verified</span>
                <% if (student.verifiedAt) { %>
                on <%= new Date(student.verifiedAt).toLocaleDateString() %>
                <% } %>
                <% } else { %>
                <span class="badge bg-warning">Pending Verification</span>
                <% } %>
            </p>
        </div>
    </div>

    <% if (typeof profile !== 'undefined' && profile) { %>
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Student Information</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-start">
                <div class="col-md-4 col-lg-3 text-center mb-4 mb-md-0">
                    <% if (profile.profilePhoto) { %>
                        <img src="<%= profile.profilePhoto %>" alt="Profile photo of <%= profile.firstName %> <%= profile.lastName %>" class="student-photo img-fluid shadow-sm">
                    <% } else { %>
                        <div class="student-photo-placeholder d-flex flex-column justify-content-center align-items-center shadow-sm">
                            <span class="fw-bold text-muted">No Photo</span>
                            <small class="text-muted">Not provided</small>
                        </div>
                    <% } %>
                </div>
                <div class="col-md-8 col-lg-9">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Student Number:</strong> <%= profile.studentNumber %></p>
                            <p><strong>Name:</strong> <%= profile.firstName %> <%= profile.middleName || '' %> <%= profile.lastName %></p>
                            <p><strong>Course:</strong> <%= profile.course %></p>
                            <p><strong>Year Level:</strong> <%= profile.yearLevel %></p>
                            <p><strong>Section:</strong> <%= profile.section || 'N/A' %></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Contact Number:</strong> <%= profile.contactNumber %></p>
                            <p><strong>Address:</strong> <%= profile.address %></p>
                            <% if (profile.emergencyContact && profile.emergencyContact.name) { %>
                            <p><strong>Emergency Contact:</strong> <%= profile.emergencyContact.name %> (<%= profile.emergencyContact.relationship %>) - <%= profile.emergencyContact.contactNumber %></p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Company Information</h5>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editCompanyInfoModal">
                <i class="bi bi-pencil"></i> Edit Company Info
            </button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Company Name:</strong> <%= profile.companyName || 'N/A' %></p>
                    <p><strong>Company Address:</strong> <%= profile.companyAddress || 'N/A' %></p>
                    <p><strong>Company Contact:</strong> <%= profile.companyContact || 'N/A' %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Supervisor Name:</strong> <%= profile.supervisorName || 'N/A' %></p>
                    <p><strong>Supervisor Position:</strong> <%= profile.supervisorPosition || 'N/A' %></p>
                    <p><strong>Supervisor Email:</strong> <%= profile.supervisorEmail || 'N/A' %></p>
                    <p><strong>Supervisor Contact:</strong> <%= profile.supervisorContact || 'N/A' %></p>
                </div>
            </div>
            <hr>
            <p><strong>OJT Period:</strong> 
                <% if (profile.ojtStartDate && profile.ojtEndDate) { %>
                    <%= new Date(profile.ojtStartDate).toLocaleDateString() %> to <%= new Date(profile.ojtEndDate).toLocaleDateString() %>
                <% } else { %>
                    <span class="text-muted">Not set</span>
                <% } %>
            </p>
        </div>
    </div>

    <!-- Edit Company Information Modal -->
    <div class="modal fade" id="editCompanyInfoModal" tabindex="-1" aria-labelledby="editCompanyInfoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editCompanyInfoModalLabel">Edit Company Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST" action="/coordinator/students/<%= student._id %>/company-info">
                    <div class="modal-body">
                        <h6 class="mb-3">Company Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="companyName" class="form-label">Company Name</label>
                                <input type="text" class="form-control" id="companyName" name="companyName" 
                                    value="<%= profile.companyName || '' %>" placeholder="Enter company name">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="companyContact" class="form-label">Company Contact</label>
                                <input type="text" class="form-control" id="companyContact" name="companyContact" 
                                    value="<%= profile.companyContact || '' %>" placeholder="Enter contact number">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="companyAddress" class="form-label">Company Address</label>
                            <textarea class="form-control" id="companyAddress" name="companyAddress" rows="2" 
                                placeholder="Enter company address"><%= profile.companyAddress || '' %></textarea>
                        </div>

                        <hr class="my-4">
                        <h6 class="mb-3">Supervisor Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="supervisorName" class="form-label">Supervisor Name</label>
                                <input type="text" class="form-control" id="supervisorName" name="supervisorName" 
                                    value="<%= profile.supervisorName || '' %>" placeholder="Enter supervisor name">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="supervisorPosition" class="form-label">Supervisor Position</label>
                                <input type="text" class="form-control" id="supervisorPosition" name="supervisorPosition" 
                                    value="<%= profile.supervisorPosition || '' %>" placeholder="Enter position">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="supervisorEmail" class="form-label">Supervisor Email</label>
                                <input type="email" class="form-control" id="supervisorEmail" name="supervisorEmail" 
                                    value="<%= profile.supervisorEmail || '' %>" placeholder="Enter email address">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="supervisorContact" class="form-label">Supervisor Contact</label>
                                <input type="text" class="form-control" id="supervisorContact" name="supervisorContact" 
                                    value="<%= profile.supervisorContact || '' %>" placeholder="Enter contact number">
                            </div>
                        </div>

                        <hr class="my-4">
                        <h6 class="mb-3">OJT Period</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="ojtStartDate" class="form-label">OJT Start Date</label>
                                <input type="date" class="form-control" id="ojtStartDate" name="ojtStartDate" 
                                    value="<%= profile.ojtStartDate ? new Date(profile.ojtStartDate).toISOString().split('T')[0] : '' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="ojtEndDate" class="form-label">OJT End Date</label>
                                <input type="date" class="form-control" id="ojtEndDate" name="ojtEndDate" 
                                    value="<%= profile.ojtEndDate ? new Date(profile.ojtEndDate).toISOString().split('T')[0] : '' %>">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <% } else { %>
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Student Information</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Profile Not Available:</strong> This student has not completed their profile yet. The profile information will appear here once the student fills out their profile.
            </div>
        </div>
    </div>
    <% } %>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">MOA Status</h5>
        </div>
        <div class="card-body">
            <% if (typeof moa !== 'undefined' && moa) { %>
            <p><strong>Status:</strong> 
                <span class="badge 
                    <% if (moa.status === 'completed') { %>bg-success
                    <% } else if (moa.status === 'for signature') { %>bg-info
                    <% } else if (moa.status === 'revise') { %>bg-warning
                    <% } else { %>bg-secondary<% } %>">
                    <%= moa.status %>
                </span>
            </p>
            <a href="/coordinator/moa" class="btn btn-primary">Manage MOA</a>
            <% } else { %>
            <p class="text-muted">MOA not uploaded yet.</p>
            <% } %>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Repository</h5>
            <a href="/coordinator/students/<%= student._id %>/repository" class="btn btn-sm btn-primary">View Repository</a>
        </div>
        <div class="card-body">
            <p><strong>Total Files:</strong> <%= typeof fileCount !== 'undefined' ? fileCount : 0 %></p>
        </div>
    </div>
    <% } else { %>
    <div class="alert alert-danger">Student not found.</div>
    <% } %>
</div>

<%- include('../partials/footer') %>

